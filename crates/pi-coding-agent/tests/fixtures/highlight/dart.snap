«syntaxType:void» «syntaxFunction:main»() => «syntaxFunction:print»(«syntaxType:Greeter»(«syntaxString:'world'»).«syntaxFunction:greet»(«syntaxNumber:2») + «syntaxNumber:true».«syntaxFunction:toString»());
