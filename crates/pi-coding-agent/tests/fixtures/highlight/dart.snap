«syntaxKeyword:import» «syntaxString:'dart:math'»;

«syntaxComment:// A greeter»
«syntaxKeyword:class» «syntaxType:Greeter» «syntaxKeyword:extends» «syntaxType:Base» {
  «syntaxKeyword:final» «syntaxType:String» name;
  «syntaxType:int» count = «syntaxNumber:42»;

  «syntaxType:Greeter»(«syntaxType:this».name);

  «muted:@override»
  «syntaxType:String» «syntaxFunction:greet»([«syntaxType:int» times = «syntaxNumber:1»]) {
    «syntaxKeyword:final» parts = <«syntaxType:String»>[];
    «syntaxKeyword:for» («syntaxKeyword:var» i = «syntaxNumber:0»; i < «syntaxFunction:max»(times, «syntaxNumber:1»); i++) {
